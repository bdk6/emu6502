typedef enum
  {
    FM_IMPL,    // No operands
    FM_A,       // A
    FM_IMM,     // #xx One byte immediate
    FM_ZP,      // xx One byte zero page address
    FM_ZPX,     // xx,X  One byte zero page indexed X
    FM_ZPY,     // xx,Y  One byte zero page indexed Y
    FM_REL,     // xx    One byte jump displacement
    FM_ABS,     // xxxx  Two byte absolute address
    FM_ABSX,    // xxxx,X Two byte address, indexed X
    FM_ABSY,    // xxxx,Y Two byte address, indexed Y
    FM_IXIN,    // (xx,X) One byte zero page indexed indirect
    FM_INIX,    // (xx),Y One byte zero page indirect indexed
    FM_IND,     // (xxxx) Two byte indirect
    FM_ILL      // Illegal op, use opcode only
  }  form_t;

typedef struct
{
  char name[4];   // Name plus null
  form_t form;    // form of the instruction
} instruction_t;

