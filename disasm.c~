{
  for(int i = 0; i < 256; i++)
    {
    printf("%03d %s form: %d\n", i,
	   instructions[i].name, instructions[i].form);
    printf("0x%04x:  ", pc);
    pc += form_print(memory, pc, (uint8_t)i);
    }
  
  return 0;
}






