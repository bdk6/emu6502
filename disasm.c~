uint16_t form_illegal(uint8_t* mem, uint16_t pc, uint8_t byte)
{
  uint16_t rtn = 1;
  printf("         ILL                 ; %02x\n", byte);
  return rtn;
}

uint16_t form_a(uint8_t* mem, uint16_t pc, uint8_t byte)
{
  uint16_t rtn = 1;
  printf("        %s A                  ; %02x\n",
	 instructions[byte].name, byte);
  return rtn;
}

uint16_t form_implied(uint8_t* mem, uint16_t pc, uint8_t byte)
{
  uint16_t rtn = 1;
  printf("        %s                    ; %02x\n",
	 instructions[byte].name, byte);
  return rtn;
}

uint16_t form_immediate(uint8_t* mem, uint16_t pc, uint8_t byte)
{
  uint16_t rtn = 2;
  printf("        %s   #0x%02x   ; %02x %02x \n",
	 instructions[byte].name, byte, mem[pc+1]);
  return rtn;
}

uint16_t form_zero_page(uint8_t* mem, uint16_t pc, uint8_t byte)
{
  uint16_t rtn = 2;
  printf("        %s   0x%02x   ; %02x %02x \n",
	 instructions[byte].name, byte, mem[pc+1]);
  return rtn;
}
uint16_t form_zero_page_x(uint8_t* mem, uint16_t pc, uint8_t byte)
{
  uint16_t rtn = 2;
  printf("       %s   0x02x   ; 502x %02x \n",
	 instructions[byte].name, byte, mem[pc+1]);
  return rtn;
}

uint16_t form_print(uint8_t* mem, uint16_t pc, uint8_t byte)
{
  uint16_t rtn = 0;
  uint8_t b1 = mem[pc + 1];
  uint8_t b2 = mem[pc + 2];
  
  form_t form = instructions[byte].form;
  switch(form)
    {
    case FM_ILL:        // Illegal opcode
      rtn = 1;
      printf("--------ILL-------- ; 0x%02x\n", byte);
      break;
    case FM_A:          // op A
      rtn = 1;
      printf("        %s  A       ; 0x%02x\n", instructions[byte].name,
	     byte);
      break;
    case FM_IMPL:       // op
      rtn = 1;
      printf("        %s          ; 0x%02x\n", instructions[byte].name,
	     byte);
      break;
    case FM_IMM:        // op #xx
      rtn = 2;
      printf("        %s #0x%02x  ; 0x%02x\n", instructions[byte].name,
	     b1, byte);
      break;
    case FM_ZP:         // op xx
      rtn = 2;
      printf("        %s 0x%02x  ; 0x%02x\n", instructions[byte].name,
	     b1, byte);
      break;
    case FM_ZPX:        // op xx,X
      rtn = 2;
      printf("        %s 0x%02x,X ; 0x%02x\n", instructions[byte].name,
	     b1, byte);
      break;
    case FM_ZPY:        // op xx,Y
      rtn = 2;
      printf("        %s 0x%02x,Y ; 0x%02x\n", instructions[byte].name,
	     b1, byte);
      break;
    case FM_REL:        // op xx
      rtn = 2;
      printf("        %s 0x%04x  ; 0x%02x 0x%02x\n",
	     instructions[byte].name, b1, byte, byte);
      break;
    case FM_ABS:        // op xxxx
      rtn = 3;
      printf("        %s 0x%04x  ; 0x%02x \n",
	     instructions[byte].name, (uint16_t) b1 | (uint16_t) b2 << 8,
	     byte);
      break;
    case FM_ABSX:       // op xxxx,X
      rtn = 3;
      printf("        %s 0x%04x,X  ; 0x%02x \n",
	     instructions[byte].name, (uint16_t) b1 | (uint16_t) b2 << 8,
             byte);
      break;
    case FM_ABSY:       // op xxxx.Y
      rtn = 3;
      printf("       %s 0x%04x,Y  ; 0x%02x \n",
	     instructions[byte].name, (uint16_t) b1 | (uint16_t) b2 << 8,
	     byte);
      break;
    case FM_IXIN:       // op (xx,x)
      rtn = 2;
      printf("      %s   (0x%02x,X)  ; 0x%02x \n",
	     instructions[byte].name, b1, byte);
      break;
    case FM_INIX:       // op (xx),Y
      rtn = 2;
      printf("     %s  (0x%02x),Y  ; 0x%02x \n",
	     instructions[byte].name, b1, byte);
      break;
    case FM_IND:        // op (xxxx)
      rtn = 3;
      printf("       %s (0x%04x)   ; 0x%02x \n",
	     instructions[byte].name, (uint16_t) b1 | (uint16_t) b2 << 8);
      break;
    default:
      rtn = 1;
      printf("ERROR: undefined opcode.  %02x *********\n", b1);
      break;
    }

  return rtn;
}

  


